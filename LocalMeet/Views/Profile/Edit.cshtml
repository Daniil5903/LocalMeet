@model EditProfileViewModel

@{
    ViewData["Title"] = "Редактирование профиля";

    var avatarPath = string.IsNullOrWhiteSpace(Model.CurrentAvatarPath)
        ? "/images/default-avatar.png"
        : Model.CurrentAvatarPath;
}

<div class="profile-edit-page">
    <div class="profile-edit-card">
        <h1 class="profile-edit-title">Редактирование профиля</h1>
        <p class="profile-edit-subtitle">
            Обновите личную информацию, аватар и настройки приватности.
        </p>

        <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="profile-avatar-edit-block">
                <img src="@avatarPath" alt="Текущий аватар" class="profile-avatar-edit" />

                <div>
                    <label asp-for="AvatarFile" class="form-label"></label>
                    <input asp-for="AvatarFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="AvatarFile" class="text-danger"></span>
                    <div class="form-text">
                        Допустимые форматы: jpg, jpeg, png. Максимальный размер файла: 2 МБ.
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="About" class="form-label"></label>
                <textarea asp-for="About" class="form-control" rows="5" placeholder="Расскажите немного о себе"></textarea>
                <span asp-validation-for="About" class="text-danger"></span>
            </div>

            <div class="privacy-box">
                <div class="form-check form-switch">
                    <input asp-for="IsPrivateProfile" class="form-check-input" />
                    <label asp-for="IsPrivateProfile" class="form-check-label"></label>
                </div>

                <div class="privacy-description">
                    Если профиль закрыт, другие пользователи не смогут видеть описание, email и статистику.
                    Администратор системы всё равно имеет полный доступ к информации.
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    Сохранить изменения
                </button>

                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">
                    Отмена
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}