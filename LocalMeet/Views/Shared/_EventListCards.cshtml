@model IEnumerable<EventListItemViewModel>

@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

@if (!Model.Any())
{
    <div class="empty-events-box">
        <h2>Мероприятий нет</h2>
        <p>Здесь пока нет подходящих мероприятий.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="event-card">
                    <div class="event-card-header">
                        <span class="badge text-bg-primary">@item.CategoryName</span>
                        <span class="badge @item.StatusCssClass">@item.StatusText</span>
                    </div>

                    <h2>@item.Title</h2>

                    <p class="event-description">
                        @item.DescriptionPreview
                    </p>

                    <div class="event-info-list">
                        <div>
                            <span>Дата</span>
                            <strong>@item.EventDate.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>

                        <div>
                            <span>Место</span>
                            <strong>@item.Address</strong>
                        </div>

                        <div>
                            <span>Организатор</span>
                            <strong>@item.CreatorName</strong>
                        </div>
                    </div>

                    <div class="event-card-footer">
                        <span class="text-muted">
                            Участников: @item.ParticipantsCount / @item.MaxParticipants
                        </span>

                        <div class="event-card-actions">
                            @if (item.CanToggleFavorite)
                            {
                                if (item.IsFavorite)
                                {
                                    <form asp-area=""
                                          asp-controller="Favorites"
                                          asp-action="Remove"
                                          asp-route-eventId="@item.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Удалить из избранного">
                                            ★
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-area=""
                                          asp-controller="Favorites"
                                          asp-action="Add"
                                          asp-route-eventId="@item.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Добавить в избранное">
                                            ☆
                                        </button>
                                    </form>
                                }
                            }

                            <a asp-area=""
                               asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}