@using LocalMeet.Data
@using LocalMeet.Models.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LocalMeet.Models.Enums

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject ApplicationDbContext DbContext

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    var avatarPath = string.IsNullOrWhiteSpace(currentUser?.AvatarPath)
        ? "/images/default-avatar.png"
        : currentUser.AvatarPath;

    var isAdmin = currentUser != null && await UserManager.IsInRoleAsync(currentUser, AppRole.Admin);

    var unreadNotificationsCount = currentUser == null
        ? 0
        : await DbContext.Notifications.CountAsync(n => n.UserId == currentUser.Id && !n.IsRead);

    var newReportsCount = isAdmin
        ? await DbContext.Reports.CountAsync(r => r.Status == ReportStatus.New)
        : 0;

    var totalHeaderCounter = unreadNotificationsCount + newReportsCount;

    var totalHeaderCounterText = totalHeaderCounter > 99
        ? "99+"
        : totalHeaderCounter.ToString();

    var unreadNotificationsText = unreadNotificationsCount > 99
        ? "99+"
        : unreadNotificationsCount.ToString();

    var newReportsText = newReportsCount > 99
        ? "99+"
        : newReportsCount.ToString();

    <div class="dropdown user-menu-dropdown">
        <button class="btn user-menu-button dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
                aria-expanded="false">
            <img src="@avatarPath"
                 alt="Аватар"
                 class="user-menu-avatar" />

            <span class="user-menu-name">@currentUser?.FirstName</span>

            @if (totalHeaderCounter > 0)
            {
                <span class="badge text-bg-danger app-counter-badge">
                    @totalHeaderCounterText
                </span>
            }
        </button>

        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <span class="dropdown-item-text text-muted">
                    @currentUser?.Email
                </span>
            </li>

            <li>
                <hr class="dropdown-divider" />
            </li>

            <li>
                <a asp-area=""
                   asp-controller="Profile"
                   asp-action="Index"
                   class="dropdown-item">
                    Профиль
                </a>
            </li>

            <li>
                <a asp-area=""
                   asp-controller="Profile"
                   asp-action="Edit"
                   class="dropdown-item">
                    Настройки профиля
                </a>
            </li>

            <li>
                <a asp-area=""
                   asp-controller="MyEvents"
                   asp-action="Index"
                   class="dropdown-item">
                    Мои мероприятия
                </a>
            </li>

            <li>
                <a asp-area=""
                   asp-controller="Favorites"
                   asp-action="Index"
                   class="dropdown-item">
                    Избранное
                </a>
            </li>

            <li>
                <a asp-area=""
                   asp-controller="Notifications"
                   asp-action="Index"
                   class="dropdown-item d-flex align-items-center justify-content-between gap-3">
                    <span>Уведомления</span>

                    @if (unreadNotificationsCount > 0)
                    {
                        <span class="badge text-bg-danger app-counter-badge">
                            @unreadNotificationsText
                        </span>
                    }
                </a>
            </li>

            @if (isAdmin)
            {
                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="dropdown-item">
                        Панель администратора
                    </a>
                </li>

                <li>
                    <a asp-area="Admin"
                       asp-controller="UserManagement"
                       asp-action="Index"
                       class="dropdown-item">
                        Пользователи
                    </a>
                </li>

                <li>
                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Index"
                       class="dropdown-item">
                        Управление категориями
                    </a>
                </li>

                <li>
                    <a asp-area="Admin"
                       asp-controller="Events"
                       asp-action="Index"
                       class="dropdown-item">
                        Модерация мероприятий
                    </a>
                </li>

                <li>
                    <a asp-area="Admin"
                       asp-controller="Reports"
                       asp-action="Index"
                       class="dropdown-item d-flex align-items-center justify-content-between gap-3">
                        <span>Жалобы</span>

                        @if (newReportsCount > 0)
                        {
                            <span class="badge text-bg-danger app-counter-badge">
                                @newReportsText
                            </span>
                        }
                    </a>
                </li>
            }

            <li>
                <hr class="dropdown-divider" />
            </li>

            <li>
                <div class="theme-menu-item">
                    <span class="theme-menu-label">
                        Темная тема
                    </span>

                    <label class="theme-switch"
                           title="Переключить тему">
                        <input type="checkbox"
                               class="theme-switch-input"
                               data-theme-switch
                               aria-label="Темная тема" />

                        <span class="theme-switch-track">
                            <span class="theme-switch-stars"></span>

                            <span class="theme-switch-thumb">
                                <span class="theme-switch-icon theme-switch-icon-sun">
                                    ☀
                                </span>

                                <span class="theme-switch-icon theme-switch-icon-moon">
                                    ☾
                                </span>
                            </span>
                        </span>
                    </label>
                </div>
            </li>

            <li>
                <hr class="dropdown-divider" />
            </li>

            <li>
                <form asp-area=""
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="dropdown-item">
                        Выйти
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="app-auth-links d-flex gap-2">
        <a asp-area=""
           asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-primary app-login-link">
            Войти
        </a>

        <a asp-area=""
           asp-controller="Account"
           asp-action="Register"
           class="btn btn-primary app-register-link">
            Регистрация
        </a>
    </div>
}