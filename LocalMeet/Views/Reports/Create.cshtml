@model CreateReportViewModel

@{
    ViewData["Title"] = "Отправка жалобы";

    string targetTypeText = Model.TargetType switch
    {
        ReportTargetType.User => "профиль пользователя",
        ReportTargetType.Event => "мероприятие",
        ReportTargetType.Message => "сообщение чата",
        _ => "объект"
    };
}

<div class="report-page">
    <div class="report-form-card">
        <h1>Отправка жалобы</h1>

        <p class="text-muted">
            Опишите причину обращения. Жалоба будет передана администрации LocalMeet.
        </p>

        <div class="alert alert-info">
            <div>
                <strong>Тип объекта:</strong> @targetTypeText
            </div>

            <div>
                <strong>Объект:</strong> @Model.TargetTitle
            </div>
        </div>

        <form asp-area="" asp-controller="Reports" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="TargetType" />
            <input type="hidden" asp-for="TargetId" />
            <input type="hidden" asp-for="TargetTitle" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="7"
                          placeholder="Опишите, что именно нарушает правила платформы"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>

                <div class="form-text">
                    Максимальная длина описания — 1000 символов.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    Отправить жалобу
                </button>

                @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">
                        Отмена
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Отмена
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}