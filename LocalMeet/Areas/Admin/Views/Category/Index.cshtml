@model IEnumerable<Category>

@{
    ViewData["Title"] = "Управление категориями";

    string GetSortIcon(string column)
    {
        var currentSort = ViewData["CurrentSort"]?.ToString();

        return column switch
        {
            "id" when string.IsNullOrWhiteSpace(currentSort) => "▲",
            "id" when currentSort == "id_desc" => "▼",

            "name" when currentSort == "name" => "▲",
            "name" when currentSort == "name_desc" => "▼",

            "events_count" when currentSort == "events_count" => "▲",
            "events_count" when currentSort == "events_count_desc" => "▼",

            _ => ""
        };
    }
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Категории мероприятий</h1>
            <p>Управление справочником категорий LocalMeet.</p>
        </div>

        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary">
            Добавить категорию
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        @if (!Model.Any())
        {
            <div class="text-muted">
                Категории пока не созданы.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>
                                <a asp-area="Admin"
                                   asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-sortOrder="@ViewData["IdSort"]"
                                   class="table-sort-link">
                                    ID @GetSortIcon("id")
                                </a>
                            </th>

                            <th>
                                <a asp-area="Admin"
                                   asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-sortOrder="@ViewData["NameSort"]"
                                   class="table-sort-link">
                                    Название @GetSortIcon("name")
                                </a>
                            </th>

                            <th>
                                <a asp-area="Admin"
                                   asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-sortOrder="@ViewData["EventsCountSort"]"
                                   class="table-sort-link">
                                    Количество мероприятий @GetSortIcon("events_count")
                                </a>
                            </th>

                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Id</td>
                                <td>
                                    <strong>@category.Name</strong>
                                </td>
                                <td>@category.Events.Count</td>
                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="Category"
                                       asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Изменить
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Category"
                                       asp-action="Delete"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Удалить
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>