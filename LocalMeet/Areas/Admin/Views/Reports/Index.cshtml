@model IEnumerable<AdminReportListItemViewModel>

@{
    ViewData["Title"] = "Жалобы";

    var currentStatus = ViewData["CurrentStatus"] as ReportStatus?;
    var currentTargetType = ViewData["CurrentTargetType"] as ReportTargetType?;
    var currentSearch = ViewData["CurrentSearch"]?.ToString();
    var pageNumber = ViewData["PageNumber"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 0;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;

    string IsStatusSelected(ReportStatus? status)
    {
        return currentStatus == status ? "selected" : "";
    }

    string IsTargetTypeSelected(ReportTargetType? targetType)
    {
        return currentTargetType == targetType ? "selected" : "";
    }
}

<div class="admin-page">
    <div class="admin-header">
        <div>
            <h1>Жалобы пользователей</h1>
            <p>Просмотр и обработка жалоб на профили, мероприятия и сообщения чата.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card mb-4">
        <form asp-area="Admin" asp-controller="Reports" asp-action="Index" method="get" class="row g-3">
            <div class="col-lg-4">
                <label class="form-label">Поиск</label>
                <input type="text"
                       name="searchQuery"
                       value="@currentSearch"
                       class="form-control"
                       placeholder="Описание, автор или ID объекта" />
            </div>

            <div class="col-lg-3">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    <option value="@ReportStatus.New" selected="@IsStatusSelected(ReportStatus.New)">Новая</option>
                    <option value="@ReportStatus.InReview" selected="@IsStatusSelected(ReportStatus.InReview)">В работе</option>
                    <option value="@ReportStatus.Closed" selected="@IsStatusSelected(ReportStatus.Closed)">Закрыта</option>
                    <option value="@ReportStatus.Rejected" selected="@IsStatusSelected(ReportStatus.Rejected)">Отклонена</option>
                </select>
            </div>

            <div class="col-lg-3">
                <label class="form-label">Тип объекта</label>
                <select name="targetType" class="form-select">
                    <option value="">Все типы</option>
                    <option value="@ReportTargetType.User" selected="@IsTargetTypeSelected(ReportTargetType.User)">Профиль</option>
                    <option value="@ReportTargetType.Event" selected="@IsTargetTypeSelected(ReportTargetType.Event)">Мероприятие</option>
                    <option value="@ReportTargetType.Message" selected="@IsTargetTypeSelected(ReportTargetType.Message)">Сообщение</option>
                </select>
            </div>

            <div class="col-lg-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    Найти
                </button>

                <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">
                    Сбросить
                </a>
            </div>
        </form>
    </div>

    <div class="admin-card">
        @if (!Model.Any())
        {
            <div class="text-muted">
                Жалобы не найдены.
            </div>
        }
        else
        {
            <div class="text-muted mb-3">
                Показано @Model.Count() из @totalItems найденных жалоб.
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Автор</th>
                            <th>Тип</th>
                            <th>Объект</th>
                            <th>Описание</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <div>@item.AuthorName</div>
                                    <small class="text-muted">@item.AuthorEmail</small>
                                </td>

                                <td>@item.TargetTypeText</td>

                                <td>
                                    <strong>@item.TargetTitle</strong>
                                </td>

                                <td>@item.DescriptionPreview</td>

                                <td>
                                    <span class="badge @item.StatusCssClass">
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="Reports"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Открыть
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="pagination-wrapper" aria-label="Навигация по жалобам">
                    <ul class="pagination mb-0">
                        <li class="page-item @(pageNumber > 1 ? "" : "disabled")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Reports"
                               asp-action="Index"
                               asp-route-status="@currentStatus"
                               asp-route-targetType="@currentTargetType"
                               asp-route-searchQuery="@currentSearch"
                               asp-route-page="@(pageNumber - 1)">
                                Назад
                            </a>
                        </li>

                        @for (var i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == pageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="Reports"
                                   asp-action="Index"
                                   asp-route-status="@currentStatus"
                                   asp-route-targetType="@currentTargetType"
                                   asp-route-searchQuery="@currentSearch"
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(pageNumber < totalPages ? "" : "disabled")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Reports"
                               asp-action="Index"
                               asp-route-status="@currentStatus"
                               asp-route-targetType="@currentTargetType"
                               asp-route-searchQuery="@currentSearch"
                               asp-route-page="@(pageNumber + 1)">
                                Вперед
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>